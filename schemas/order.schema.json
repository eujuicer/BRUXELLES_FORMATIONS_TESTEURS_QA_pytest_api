{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "event_id", "status", "total_cents", "created_at", "expires_at", "items"],
  "properties": {
    "id": {"type": "integer"},
    "event_id": {"type": "integer"},
    "status": {"type": "string", "enum": ["pending", "paid", "cancelled", "expired"]},
    "total_cents": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "expires_at": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category_id", "quantity", "unit_price_cents"],
        "properties": {
          "category_id": {"type": "integer"},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 6},
          "unit_price_cents": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
