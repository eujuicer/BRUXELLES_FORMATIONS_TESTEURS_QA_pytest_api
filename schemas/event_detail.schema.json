{
  "type": "object",
  "required": ["id", "title", "description", "city", "venue", "starts_at", "capacity", "status", "cover_color", "categories", "available"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "city": {"type": "string", "minLength": 1},
    "venue": {"type": "string"},
    "starts_at": {"type": "string"},
    "capacity": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "published", "archived"]},
    "cover_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "available": {"type": "integer", "minimum": 0},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "price_cents", "quota", "available"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "price_cents": {"type": "integer", "minimum": 0},
          "quota": {"type": "integer", "minimum": 0},
          "available": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
